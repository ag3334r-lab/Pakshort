rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 1. Users Collection
    match /users/{userId} {
      allow read: if true;
      allow create: if isOwner(userId) 
        && incoming().uid == userId
        && incoming().username is string
        && incoming().createdAt == request.time;
      allow update: if isOwner(userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['username', 'bio', 'profilePic', 'followersCount', 'followingCount']);
    }

    // 2. Videos Collection
    match /videos/{videoId} {
      allow read: if true;
      allow create: if isSignedIn()
        && incoming().userId == request.auth.uid
        && incoming().videoUrl is string
        && incoming().createdAt == request.time;
      allow update: if isSignedIn()
        && (
          // Like/Comment count increment (can be done by anyone signed in)
          incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'commentsCount'])
          || isOwner(existing().userId)
        );
      allow delete: if isOwner(existing().userId);

      // Subcollections
      match /likes/{userId} {
        allow read: if true;
        allow write: if isOwner(userId);
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn() 
          && incoming().userId == request.auth.uid
          && incoming().text is string
          && incoming().text.size() < 1000;
        allow delete: if isSignedIn() && (isOwner(request.auth.uid) || isOwner(get(/databases/$(database)/documents/videos/$(videoId)).data.userId));
      }
    }
  }
}
